{
  "name": "wafrn-sdk",
  "version": "1.0.0",
  "description": "Wafrn SDK for Node.js",
  "type": "commonjs",
  "main": "./dist/src/index.js",
  "scripts": {
    "clean": "npx tsc --build --clean",
    "test": "npx jest --ci --runInBand",
    "build": "npx tsc",
    "lint": "npx eslint . --ext .ts",
    "lint:fix": "yarn run lint --fix",
    "publish:local": "npm run build && yalc push"
  },
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    }
  },
  "files": [
    "dist/"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gabygarro/wafrn-sdk.git"
  },
  "keywords": [
    "wafrn",
    "sdk",
    "node"
  ],
  "author": "Gabriela Garro",
  "license": "GPL-3.0",
  "bugs": {
    "url": "https://github.com/gabygarro/wafrn-sdk/issues"
  },
  "homepage": "https://github.com/gabygarro/wafrn-sdk#readme",
  "devDependencies": {
    "@trivago/prettier-plugin-sort-imports": "^4.1.1",
    "@types/jest": "^29.4.0",
    "@typescript-eslint/eslint-plugin": "^6.20.0",
    "@typescript-eslint/parser": "^6.20.0",
    "eslint": "^8.45.0",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-config-airbnb-typescript": "^17.1.0",
    "eslint-config-prettier": "^8.8.0",
    "eslint-plugin-import": "^2.27.5",
    "eslint-plugin-jest": "^27.6.3",
    "eslint-plugin-prettier": "^5.0.0",
    "jest": "^29.5.0",
    "prettier": "^3.0.0",
    "ts-jest": "^29.0.5",
    "typedoc": "0.25.0",
    "typescript": "5.1.6"
  },
  "dependencies": {
    "axios": "^1.9.0"
  }
}
